{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.kltyton.kltytonui.fabric.KltytonUIFabric"],
    "client": ["io.github.kltyton.kltytonui.fabric.KltytonUIFabricClient"]
  },
  "mixins": [
    "kltytonui.fabric.mixins.json"
  ],
  "accessWidener": "kltytonui.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "rhino": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=21"
  }
}
